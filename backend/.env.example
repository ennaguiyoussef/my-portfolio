# === Groq API (chat) ===
# Get a key at https://console.groq.com  (starts with "gsk_")
# NOTE: the variable name is GROQ_API_KEY (with a G). A typo such as
# QROQ_API_KEY means the key is never loaded and every chat call fails.
GROQ_API_KEY=your-groq-api-key-here

# Chat model, served by Groq. Must support tool/function calling (the agent
# binds 3 tools). Run `python probe_groq.py` to list the models your account
# can see and confirm the one you pick supports tool calls.
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# === NVIDIA API (embeddings) ===
# Get a key at https://build.nvidia.com  (starts with "nvapi-")
NVIDIA_API_KEY=your-nvidia-api-key-here

# Embedding model, served by NVIDIA (multilingual, retrieval-optimized).
# Confirmed working: nvidia/nemotron-3-embed-1b. NVIDIA retires models often, so
# if ingest returns [410] Gone, probe for a live one. Re-run ingest if changed.
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# === Generation tunables ===
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=1024

# === Retrieval / vector store ===
CHROMA_COLLECTION=portfolio
RETRIEVER_K=5
HISTORY_WINDOW=10

# === CORS ===
# Comma-separated list of frontend origins allowed to call the API.
# Dev default covers Vite (5173) and CRA (3000). In production, add your
# deployed site origin, e.g.:
#   CORS_ORIGINS=http://localhost:5173,https://your-portfolio.netlify.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === Admin API key (protects /api/projects writes and /api/admin/*) ===
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# You send this in the "X-API-Key" header to unlock the admin panel (#admin).
ADMIN_API_KEY=your-strong-random-admin-key-here

# === Uploads ===
# Directory (relative to backend/) where uploaded project images are stored.
# They are served publicly at /uploads/...
UPLOAD_DIR=uploads
# Absolute base URL of this API in production, used to build public image/CV
# URLs (e.g. https://api.your-portfolio.com). Leave blank in dev.
PUBLIC_BASE_URL=

# === Contact email notification (Gmail SMTP) ===
# Optional. When set, a notification email is sent to CONTACT_NOTIFY_TO every
# time a visitor submits the contact form (or the chatbot saves a request).
# Use a Google App Password (Security > App passwords), NOT your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
CONTACT_NOTIFY_TO=youssef.ennagui@usmba.ac.ma
# From address (defaults to SMTP_USER when blank).
SMTP_FROM=
