# Base URL of the FastAPI backend.
# Dev (default): the API runs locally on port 8000.
VITE_API_URL=http://localhost:8000

# Production: set this to your deployed API origin (no trailing slash), e.g.
#   VITE_API_URL=https://your-portfolio-api.onrender.com
# On Netlify, add it under Site settings > Environment variables and redeploy.
# Also add that same frontend origin to CORS_ORIGINS in the backend .env.
